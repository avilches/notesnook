# Notesnook Self-Hosted Configuration
# Copy this file to .env and customize as needed

# ============================================
# REQUIRED - Basic Configuration
# ============================================
INSTANCE_NAME=my-notesnook

# API Secret - generate a secure random string
NOTESNOOK_API_SECRET=your-super-secret-api-key-min-32-chars
# Set to 0 to allow new user registrations, 1 to disable
DISABLE_SIGNUPS=0

# ============================================
# SMTP - Email Configuration
# ============================================
# For local development with MailHog:
# Access Mailhog UI at http://localhost:8025 to see emails
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=notesnook@localhost
SMTP_PASSWORD=mailhog
# Sender email (appears as "From" in emails)
NOTESNOOK_SENDER_EMAIL=notesnook@localhost

# For production, use your real SMTP server:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTESNOOK_SENDER_EMAIL=noreply@YOUR_DOMAIN

# ============================================
# MinIO S3 Storage (optional, has defaults)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ============================================
# PUBLIC URLs - For VPS/Production deployment
# ============================================
# Uncomment and set these when deploying to a VPS
# Replace YOUR_DOMAIN with your actual domain or IP

# APP_HOST=https://notes.YOUR_DOMAIN
# API_HOST=https://api.YOUR_DOMAIN
# AUTH_HOST=https://auth.YOUR_DOMAIN
# SSE_HOST=https://sse.YOUR_DOMAIN
# MONOGRAPH_HOST=https://mono.YOUR_DOMAIN
# S3_HOST=https://s3.YOUR_DOMAIN

# Public URLs for services (using localhost for local self-hosting)
AUTH_SERVER_PUBLIC_URL=http://localhost:8264
NOTESNOOK_APP_PUBLIC_URL=http://localhost:3000
MONOGRAPH_PUBLIC_URL=http://localhost:6264
ATTACHMENTS_SERVER_PUBLIC_URL=http://localhost:9000

# Public VPS version
# AUTH_SERVER_PUBLIC_URL=https://auth.YOUR_DOMAIN
# NOTESNOOK_APP_PUBLIC_URL=https://api.YOUR_DOMAIN
# MONOGRAPH_PUBLIC_URL=https://mono.YOUR_DOMAIN
# ATTACHMENTS_SERVER_PUBLIC_URL=https://s3.YOUR_DOMAIN

